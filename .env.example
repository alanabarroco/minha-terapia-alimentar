# Copie para .env (NUNCA envie o .env ao Git). Sem segredos reais neste arquivo.
NODE_ENV=production
PORT=3000
# Endereço público do aplicativo (usado nos links de convite/recuperação)
APP_URL=https://minha-terapia.exemplo.com.br
# PostgreSQL (usuário NÃO superusuário; veja README, passo 2)
DATABASE_URL=postgres://mta_app:TROQUE_A_SENHA@HOST:5432/mta
# Pasta PRIVADA de arquivos (fotos/PDFs). Use um volume persistente com backup.
DATA_DIR=/data
# 1 se o app estiver atrás de proxy reverso confiável (Railway, Render, Fly, Nginx)
TRUST_PROXY=1
# Duração máxima da sessão (horas) e inatividade (minutos)
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
# Envio de e-mail (opcional; sem isto, os links aparecem para o master copiar). Provedor: Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=
